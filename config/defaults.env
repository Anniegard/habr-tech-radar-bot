# Non-secret defaults shipped with the repo. Override in `.env` or the environment.
# Long keyword lexicons (HTR_SCORE_*_KEYWORDS) stay in code unless you set them explicitly.
# Prefix: HTR_

HTR_LOG_LEVEL=INFO
HTR_DRY_RUN=true
HTR_DEMO_MODE=false

# Default RSS feed(s): built into code (https://habr.com/ru/rss/articles/).
# Override with JSON array, e.g. HTR_HABR_RSS_URLS=["https://habr.com/ru/rss/all/"]

HTR_RSS_FETCH_TIMEOUT_SECONDS=30

# Seen article IDs (JSON). Relative paths use cwd or HTR_PROJECT_ROOT.
HTR_STATE_FILE=.habr_tech_radar_seen.json

# Top N after scoring (per run)
HTR_MAX_SELECTED_ARTICLES=20

# prod = compact HTML; debug = full score breakdown
HTR_TELEGRAM_FORMAT_MODE=prod

# Score weights (integers)
HTR_SCORE_WEIGHT_INCLUDE_KEYWORD=5
HTR_SCORE_WEIGHT_STRONG_KEYWORD=12
HTR_SCORE_WEIGHT_TECHNICAL_SIGNAL=10
HTR_SCORE_WEIGHT_PENALTY_PER_HIT=4
HTR_SCORE_WEIGHT_INCLUDE_HUB=8
HTR_SCORE_WEIGHT_TITLE_MATCH_BONUS=3
HTR_SCORE_WEIGHT_RECENCY_MAX=4
HTR_SCORE_RECENCY_WINDOW_DAYS=14

# Telegram delivery: retries and monotonic time budget for the whole delivery phase (seconds)
HTR_TELEGRAM_SEND_MAX_ATTEMPTS=4
HTR_TELEGRAM_RETRY_BASE_SECONDS=1.0
HTR_TELEGRAM_MAX_DELIVERY_SECONDS=240

# Last run snapshot (atomic JSON), relative to cwd or HTR_PROJECT_ROOT
HTR_LAST_RUN_PATH=.runtime/last_run.json

# --health-summary: max age (minutes) of a successful last run
HTR_HEALTH_MAX_AGE_MINUTES=180

# Hybrid scoring (stage 1): keyword 0..50 + optional LLM 0..50 = total 0..100
# LLM runs only when enabled, OpenAI key is set, and keyword score >= threshold.
HTR_LLM_SCORING_ENABLED=true
HTR_LLM_KEYWORD_THRESHOLD=20
HTR_LLM_MODEL=gpt-4o-mini
HTR_LLM_REQUEST_TIMEOUT_SECONDS=20
HTR_LLM_MAX_ARTICLE_CHARS=12000
HTR_LLM_MAX_SUMMARY_CHARS=1200
HTR_LLM_FETCH_ARTICLE_TIMEOUT_SECONDS=8
HTR_LLM_FETCH_ARTICLE_ENABLED=true
