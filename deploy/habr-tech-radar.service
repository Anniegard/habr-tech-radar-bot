# Habr Tech Radar — one-shot pipeline run (triggered by habr-tech-radar.timer).
#
# Before enabling:
#   1. Create a dedicated Unix user (example: htrbot) — not root.
#   2. Clone the repo and create .venv; set WorkingDirectory / ExecStart paths below.
#   3. Create .env in the repo root from .env.example (secrets + overrides; defaults are in config/defaults.env).
#      Or point EnvironmentFile elsewhere.
#   4. If using HTR_STATE_FILE or HTR_LAST_RUN_PATH under /var/lib/..., create dirs and chown to User.
#   5. For overlap lock (default /var/lib/habr-tech-radar/pipeline.lock): mkdir + chown that
#      directory so the service user can create the lock file (see deploy/run_once.sh).
#
# Install (from repo root, after editing paths):
#   sudo install -m 0644 deploy/habr-tech-radar.service /etc/systemd/system/
#   sudo systemctl daemon-reload

[Unit]
Description=Habr Tech Radar (one-shot RSS pipeline)
Documentation=file:///home/htrbot/habr-tech-radar-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=htrbot
Group=htrbot

# Git clone root — pydantic loads .env from cwd; relative HTR_STATE_FILE resolves here too.
WorkingDirectory=/home/htrbot/habr-tech-radar-bot

# Optional: omit leading "-" once the file exists (leading "-" = ignore if missing).
EnvironmentFile=-/home/htrbot/habr-tech-radar-bot/.env
Environment=PYTHONUNBUFFERED=1
# Optional: non-default flock path (must be writable by User)
# Environment=HTR_PIPELINE_LOCK_FILE=/var/lib/htrbot/habr-tech-radar/pipeline.lock

# flock wrapper — prevents overlapping scheduled runs; skips cleanly if lock held.
ExecStart=/home/htrbot/habr-tech-radar-bot/deploy/run_once.sh

# Kill stuck runs (RSS + Telegram); increase if feeds are very slow.
TimeoutStartSec=600

# Timer schedules the next run; do not auto-restart failed jobs in a tight loop.
Restart=no

# Hardening (optional; uncomment if compatible with your layout)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
