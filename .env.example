# Habr Tech Radar — copy to .env in the repo root (or point systemd EnvironmentFile here).
# Prefix: HTR_
#
# On a VM: set WorkingDirectory to the clone path in systemd so relative paths below resolve
# predictably; optionally set HTR_PROJECT_ROOT + absolute HTR_STATE_FILE (see comments).

# Logging: DEBUG, INFO, WARNING, ERROR
HTR_LOG_LEVEL=INFO

# When true: no Telegram Bot API HTTP calls; messages are formatted and logged as "would send".
# When false: real sendMessage requests (requires HTR_TELEGRAM_BOT_TOKEN and HTR_TELEGRAM_CHAT_ID).
HTR_DRY_RUN=true

# Set to 1 for one synthetic article and full pipeline (no network). Prefer CLI: --demo
HTR_DEMO_MODE=false

# Optional: anchor for relative HTR_STATE_FILE (e.g. when cwd is not the repo root).
# Example VM layout: state under /var/lib with repo in /home/htrbot/...
# HTR_PROJECT_ROOT=/var/lib/htrbot/habr-tech-radar

# RSS feeds (comma or whitespace separated). Empty = no HTTP requests (tests / offline).
# Default when unset: https://habr.com/ru/rss/articles/
# HTR_HABR_RSS_URLS=https://habr.com/ru/rss/articles/

# Seen article IDs (JSON). Default: .habr_tech_radar_seen.json relative to cwd or HTR_PROJECT_ROOT.
# VM example (create directory and chown to the service user):
# HTR_STATE_FILE=/var/lib/htrbot/habr-tech-radar/seen.json
# HTR_STATE_FILE=.habr_tech_radar_seen.json

# Per-feed HTTP timeout (seconds)
# HTR_RSS_FETCH_TIMEOUT_SECONDS=30

# Filtering (comma or whitespace separated; case-insensitive substring match)
# Leave include lists empty for permissive mode (only exclude rules apply).
# HTR_INCLUDE_KEYWORDS=python, asyncio
# HTR_EXCLUDE_KEYWORDS=реклама
# HTR_INCLUDE_HUBS=python
# HTR_EXCLUDE_HUBS=копирайт

# Top N articles after scoring (per run)
# HTR_MAX_SELECTED_ARTICLES=20

# Telegram message layout: prod (compact) or debug (full score breakdown)
# HTR_TELEGRAM_FORMAT_MODE=prod

# Score weights (integers; optional tuning)
# HTR_SCORE_WEIGHT_INCLUDE_KEYWORD=5
# HTR_SCORE_WEIGHT_STRONG_KEYWORD=12
# HTR_SCORE_WEIGHT_TECHNICAL_SIGNAL=10
# HTR_SCORE_WEIGHT_PENALTY_PER_HIT=4
# HTR_SCORE_WEIGHT_INCLUDE_HUB=8
# HTR_SCORE_WEIGHT_TITLE_MATCH_BONUS=3
# HTR_SCORE_WEIGHT_RECENCY_MAX=4
# HTR_SCORE_RECENCY_MAX_POINTS=
# HTR_SCORE_RECENCY_WINDOW_DAYS=14

# Strong / technical / negative lexicons for scoring (comma or whitespace; substring match).
# Leave unset to use built-in defaults in code; set to empty string to disable defaults.
# HTR_SCORE_STRONG_KEYWORDS=
# HTR_SCORE_TECHNICAL_KEYWORDS=
# HTR_SCORE_NEGATIVE_KEYWORDS=

# Telegram Bot API — required for live delivery when HTR_DRY_RUN=false.
# Create a bot via @BotFather; chat id is your user or group id (e.g. from @userinfobot).
# With HTR_DRY_RUN=true these may be empty.
# Placeholders only — replace with your real token and chat id.
HTR_TELEGRAM_BOT_TOKEN=123456789:AAHe8FakeTokenExampleReplaceMe
HTR_TELEGRAM_CHAT_ID=-1001234567890

# Live sendMessage retries (per article): max attempts (>=1) and base seconds for exponential backoff (capped internally).
# HTR_TELEGRAM_SEND_MAX_ATTEMPTS=4
# HTR_TELEGRAM_RETRY_BASE_SECONDS=1.0

# Monotonic time budget (seconds) for the entire Telegram delivery phase (per run). Retries stop if budget is exhausted.
# HTR_TELEGRAM_MAX_DELIVERY_SECONDS=240

# Last pipeline run snapshot (atomic JSON). Default: .runtime/last_run.json under cwd / HTR_PROJECT_ROOT.
# VM example:
# HTR_LAST_RUN_PATH=/var/lib/htrbot/habr-tech-radar/last_run.json

# Health check (--health-summary): max age in minutes of finished_at_utc for a "fresh" successful run.
# HTR_HEALTH_MAX_AGE_MINUTES=180

# systemd only: path for deploy/run_once.sh flock lock file (default /var/lib/habr-tech-radar/pipeline.lock).
# Usually set in the unit file as Environment=, not in .env.
# HTR_PIPELINE_LOCK_FILE=/var/lib/habr-tech-radar/pipeline.lock

# Future (Stage 2 LLM slice — not wired in this repo)
HTR_OPENAI_API_KEY=
