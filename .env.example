# Copy to `.env` in the repo root (chmod 600). Fill secrets and machine-specific values.
#
# Load order: code defaults → config/defaults.env → .env → environment (strongest).
# Prefix: HTR_
#
# Tracked non-secret defaults: config/defaults.env
# Full variable reference: README.md (section «Переменные окружения»).

# --- Secrets (set in .env; never commit real values) ---
HTR_TELEGRAM_BOT_TOKEN=
HTR_TELEGRAM_CHAT_ID=
HTR_OPENAI_API_KEY=

# --- Optional: installation-specific paths (empty = use cwd; see README) ---
# HTR_PROJECT_ROOT=
