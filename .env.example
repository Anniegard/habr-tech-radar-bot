# Local secrets and overrides — copy to `.env` in the repo root (chmod 600).
# Tracked defaults: config/defaults.env (loaded first; this file wins on conflicts).
# Prefix: HTR_
#
# Load order: code defaults → config/defaults.env → .env → environment (strongest).

# --- Telegram (required for real delivery when HTR_DRY_RUN=false) ---
HTR_TELEGRAM_BOT_TOKEN=
HTR_TELEGRAM_CHAT_ID=

# --- Common overrides (optional) ---
# HTR_DRY_RUN=false
# HTR_PROJECT_ROOT=/var/lib/htrbot/habr-tech-radar
# HTR_STATE_FILE=/var/lib/htrbot/habr-tech-radar/seen.json
# HTR_LAST_RUN_PATH=/var/lib/htrbot/habr-tech-radar/last_run.json

# Full variable list: README.md «Переменные окружения»; non-secret defaults: config/defaults.env
